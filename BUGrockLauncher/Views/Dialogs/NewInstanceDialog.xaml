<Window x:Class="BUGrockLauncher.Views.Dialogs.NewInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Game Installation"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="540"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#48BB78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2F855A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E202A"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderBrush" Value="#2F3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#282A38"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#171822"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E92A4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E53E3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Glow / Shadow border container -->
    <Grid Margin="10">
        <Border Background="#12131A" CornerRadius="10" BorderBrush="#252736" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="#161720" CornerRadius="10,10,0,0" BorderBrush="#1F202B" BorderThickness="0,0,0,1" Padding="18,0,12,0" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="3" Background="#1C2E22" BorderBrush="#38A169" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Image Source="/Assets/bugrock_block.png" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="NEW GAME INSTALLATION" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource DialogCloseButtonStyle}" Click="BtnCancel_Click" Content="&#x2715;"/>
                    </Grid>
                </Border>

                <!-- Content Body -->
                <StackPanel Grid.Row="1" Margin="22,18,22,16">
                    <TextBlock x:Name="VersionHeadingText" Text="Minecraft 1.21.50 (GDK Release)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="Set a custom name and install location for this instance:" Foreground="#8E92A4" FontSize="12" Margin="0,0,0,14"/>

                    <!-- Instance Custom Name Input -->
                    <Border Background="#181922" BorderBrush="#262838" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Instance Name (e.g. Survival, PvP, Addon Testing):" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtInstanceName" Height="36" Background="#0C0D12" Foreground="#FFFFFF" BorderBrush="#38A169" BorderThickness="1" Padding="10,6" VerticalContentAlignment="Center" FontSize="13" FontWeight="SemiBold" TextChanged="TxtInstanceName_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Destination Option: instances folder -->
                    <Border Background="#181922" BorderBrush="#262838" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8" MouseLeftButtonDown="DefaultCard_Click" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="RbDefault" Grid.Column="0" GroupName="InstallLocationGroup" IsChecked="True" VerticalAlignment="Top" Margin="0,2,10,0" Checked="RbDefault_Checked"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Standard instances Directory (Recommended)" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13"/>
                                <TextBlock x:Name="DefaultPathPreviewText" Text="E:\...\BUGrock_Launcher_Bin\instances\..." Foreground="#38A169" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,2"/>
                                <TextBlock Text="Isolated worlds, mods, and packages are cleanly kept inside instances\." Foreground="#606478" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Destination Option: Custom Directory -->
                    <Border Background="#181922" BorderBrush="#262838" BorderThickness="1" CornerRadius="8" Padding="14" MouseLeftButtonDown="CustomCard_Click" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton x:Name="RbCustom" Grid.Column="0" GroupName="InstallLocationGroup" VerticalAlignment="Top" Margin="0,2,10,0" Checked="RbCustom_Checked"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Custom Directory" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13"/>
                                <TextBlock Text="Choose a specific folder on any drive:" Foreground="#8E92A4" FontSize="11" Margin="0,4,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="TxtCustomPath" Grid.Column="0" Height="34" Background="#0C0D12" Foreground="#FFFFFF" BorderBrush="#2D3040" BorderThickness="1" Padding="8,4" VerticalContentAlignment="Center" FontSize="12" IsEnabled="False"/>

                                    <Button x:Name="BtnBrowse" Grid.Column="1" Click="BtnBrowse_Click" Content="Browse..." Style="{StaticResource DialogSecondaryButtonStyle}" Margin="8,0,0,0" Height="34" MinWidth="80" IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" Background="#161720" CornerRadius="0,0,10,10" Padding="20,14" BorderBrush="#1F202B" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCancel_Click" Content="CANCEL" Style="{StaticResource DialogSecondaryButtonStyle}" Margin="0,0,10,0"/>
                        <Button Click="BtnInstall_Click" Content="DOWNLOAD &amp; INSTALL" Style="{StaticResource DialogPrimaryButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

