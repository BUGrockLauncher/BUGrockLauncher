<Window x:Class="BUGrockLauncher.MainWindow"



        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"



        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"



        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"



        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"



        xmlns:local="clr-namespace:BUGrockLauncher.WPFDataTypes"



        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"



        mc:Ignorable="d"



        Title="BUGrock Launcher [Beta]" 



        Height="780" Width="1200"



        MinHeight="660" MinWidth="1020"



        WindowStartupLocation="CenterScreen"



        Background="#0F1015"



        Icon="Assets/bugrock.ico"



        FontFamily="{StaticResource FontTajawal}"



        MouseMove="Window_MouseMove"



        MouseLeave="Window_MouseLeave">







    <WindowChrome.WindowChrome>



        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/>



    </WindowChrome.WindowChrome>







    <Window.Resources>



        <!-- Accent Color Tokens -->



        <SolidColorBrush x:Key="AccentGreen" Color="#38A169"/>



        <SolidColorBrush x:Key="AccentMagenta" Color="#D05CE3"/>







        <!-- Version List Collection Views -->



        <CollectionViewSource x:Key="versionListViewAll" IsLiveFilteringRequested="True"/>



        <CollectionViewSource x:Key="versionListViewRelease" IsLiveFilteringRequested="True"/>



        <CollectionViewSource x:Key="versionListViewBeta" IsLiveFilteringRequested="True"/>



        <CollectionViewSource x:Key="versionListViewPreview" IsLiveFilteringRequested="True"/>



        <CollectionViewSource x:Key="versionListViewImported" IsLiveFilteringRequested="True"/>







        <!-- Top Navigation Tab RadioButton Style (NO blue highlight, clean green underline) -->



        <Style x:Key="TopNavTabStyle" TargetType="RadioButton">



            <Setter Property="FontFamily" Value="{StaticResource FontEpilogue}"/>



            <Setter Property="Background" Value="Transparent"/>



            <Setter Property="Foreground" Value="#8E92A4"/>



            <Setter Property="FontSize" Value="13"/>



            <Setter Property="FontWeight" Value="SemiBold"/>



            <Setter Property="Cursor" Value="Hand"/>



            <Setter Property="Margin" Value="0,0,28,0"/>



            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="RadioButton">



                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="2,12,2,12">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsChecked" Value="True">



                                <Setter Property="Foreground" Value="#FFFFFF"/>



                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38A169"/>



                            </Trigger>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter Property="Foreground" Value="#FFFFFF"/>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







        <!-- Sub Filter Tab RadioButton Style (High Contrast Modern Pills) -->



        <Style x:Key="SubFilterTabStyle" TargetType="RadioButton">



            <Setter Property="FontFamily" Value="{StaticResource FontTajawal}"/>



            <Setter Property="Background" Value="#171924"/>



            <Setter Property="Foreground" Value="#CBD5E1"/>



            <Setter Property="FontSize" Value="12"/>



            <Setter Property="FontWeight" Value="SemiBold"/>



            <Setter Property="Cursor" Value="Hand"/>



            <Setter Property="Margin" Value="0,0,8,0"/>



            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="RadioButton">



                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#2D3144" CornerRadius="5" Padding="12,5">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsChecked" Value="True">



                                <Setter Property="Foreground" Value="#FFFFFF"/>



                                <Setter Property="FontWeight" Value="Bold"/>



                                <Setter TargetName="TabBorder" Property="Background" Value="#1C3527"/>



                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38A169"/>



                            </Trigger>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter Property="Foreground" Value="#FFFFFF"/>



                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#48BB78"/>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







        <Style x:Key="VersionSubTabStyle" BasedOn="{StaticResource SubFilterTabStyle}" TargetType="RadioButton"/>







        <!-- Giant PLAY Pixel Button Style -->



        <Style x:Key="GiantPlayButtonStyle" TargetType="Button">



            <Setter Property="FontFamily" Value="{StaticResource FontEpilogue}"/>



            <Setter Property="Background" Value="#38A169"/>



            <Setter Property="Foreground" Value="#FFFFFF"/>



            <Setter Property="FontWeight" Value="Bold"/>



            <Setter Property="FontSize" Value="22"/>



            <Setter Property="Cursor" Value="Hand"/>



            <Setter Property="Padding" Value="18,6"/>



            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="#276749" BorderThickness="0,0,0,3" CornerRadius="6" Padding="{TemplateBinding Padding}">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">



                                <ContentPresenter.Effect>



                                    <DropShadowEffect Color="#1E4E38" BlurRadius="2" ShadowDepth="2" Direction="270" Opacity="0.9"/>



                                </ContentPresenter.Effect>



                            </ContentPresenter>



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="btnBorder" Property="Background" Value="#48BB78"/>



                            </Trigger>



                            <Trigger Property="IsPressed" Value="True">



                                <Setter TargetName="btnBorder" Property="Background" Value="#276749"/>



                                <Setter TargetName="btnBorder" Property="BorderThickness" Value="0,2,0,0"/>



                            </Trigger>



                            <Trigger Property="IsEnabled" Value="False">



                                <Setter TargetName="btnBorder" Property="Background" Value="#232530"/>



                                <Setter Property="Foreground" Value="#606478"/>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







        <!-- Modern Dark Theme CheckBox Style -->



        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">



            <Setter Property="Foreground" Value="#E2E8F0"/>



            <Setter Property="FontSize" Value="11"/>



            <Setter Property="Cursor" Value="Hand"/>



            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="CheckBox">



                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                            <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="4" Background="#161822" BorderBrush="#36394D" BorderThickness="1.5" VerticalAlignment="Center">



                                <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" Margin="0,-1,0,0"/>



                            </Border>



                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>



                        </StackPanel>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsChecked" Value="True">



                                <Setter TargetName="CheckBorder" Property="Background" Value="#38A169"/>



                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#48BB78"/>



                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>



                            </Trigger>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#48BB78"/>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







        <!-- Secondary Dark Button Style -->



        <Style x:Key="DarkButtonStyle" TargetType="Button">



            <Setter Property="FontFamily" Value="{StaticResource FontEpilogue}"/>



            <Setter Property="Background" Value="#1C1E2A"/>



            <Setter Property="Foreground" Value="#FFFFFF"/>



            <Setter Property="FontWeight" Value="SemiBold"/>



            <Setter Property="FontSize" Value="12"/>



            <Setter Property="Cursor" Value="Hand"/>



            <Setter Property="Padding" Value="14,6"/>



            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="#323548" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="btnBorder" Property="Background" Value="#282B3C"/>



                            </Trigger>



                            <Trigger Property="IsPressed" Value="True">



                                <Setter TargetName="btnBorder" Property="Background" Value="#161722"/>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







        <!-- Danger / Remove Button Style -->



        <Style x:Key="DangerButtonStyle" TargetType="Button">



            <Setter Property="FontFamily" Value="{StaticResource FontEpilogue}"/>



            <Setter Property="Background" Value="#13141A"/>



            <Setter Property="Foreground" Value="#8E92A4"/>



            <Setter Property="FontWeight" Value="SemiBold"/>



            <Setter Property="FontSize" Value="12"/>



            <Setter Property="Cursor" Value="Hand"/>



            <Setter Property="Padding" Value="10,6"/>



            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="#232530" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="btnBorder" Property="Background" Value="#3B1C1C"/>



                                <Setter Property="Foreground" Value="#FF6B6B"/>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







        <!-- Hero Cancel Button Style -->



        <Style x:Key="HeroCancelButtonStyle" TargetType="Button">



            <Setter Property="Background" Value="Transparent"/>



            <Setter Property="Foreground" Value="#8E92A4"/>



            <Setter Property="FontSize" Value="11"/>



            <Setter Property="Cursor" Value="Hand"/>



            <Setter Property="BorderThickness" Value="0"/>



            <Setter Property="Width" Value="22"/>



            <Setter Property="Height" Value="22"/>



            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="btnBorder" Property="Background" Value="#E53E3E"/>



                                <Setter Property="Foreground" Value="#FFFFFF"/>



                            </Trigger>



                            <Trigger Property="IsPressed" Value="True">



                                <Setter TargetName="btnBorder" Property="Background" Value="#C53030"/>



                                <Setter Property="Foreground" Value="#FFFFFF"/>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







        <!-- Template for Version Not Installed (Clean Card with Subtle Contrast, Bedrock Block Icon, Gray RELEASE badge, DOWNLOAD button) -->



        <DataTemplate x:Key="templateVersionNotInstalled" DataType="{x:Type local:Version}">



            <Border Background="#1C1E2A" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="16,14">



                <Grid>



                    <Grid.ColumnDefinitions>



                        <ColumnDefinition Width="Auto" />



                        <ColumnDefinition Width="*" />



                        <ColumnDefinition Width="Auto" />



                    </Grid.ColumnDefinitions>



                    



                    <!-- Meaningful & Visible Minecraft Block Icon -->



                    <Border Grid.Column="0" Width="40" Height="40" Background="#14151F" BorderBrush="#35384D" BorderThickness="1.5" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Center">



                        <Image Source="Assets/bugrock_block.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>



                    </Border>



                    



                    <StackPanel Grid.Column="1" VerticalAlignment="Center">



                        <StackPanel Orientation="Horizontal">



                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>



                            <Border Background="#242636" BorderBrush="#32354A" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">



                                <TextBlock Text="{Binding DisplayVersionType}" Foreground="#A0A5BD" FontSize="10" FontWeight="Bold"/>



                            </Border>



                        </StackPanel>



                        <TextBlock Text="Not installed &#x2022; Online Repository" Foreground="#767A92" FontSize="11" Margin="0,4,0,0"/>



                    </StackPanel>







                    <Button x:Name="DownloadButton" Grid.Column="2" Style="{StaticResource DarkButtonStyle}" Command="{Binding DownloadCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" MinWidth="128" Height="38" Padding="14,6">



                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">



                            <Path Data="M12 3v10m0 0l-4-4m4 4l4-4M4 17v2a1 1 0 001 1h14a1 1 0 001-1v-2" Stroke="#4ADE80" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>



                            <TextBlock Text="DOWNLOAD" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>



                        </StackPanel>



                    </Button>



                </Grid>



            </Border>



        </DataTemplate>







        <!-- Template for Version Installed (Clean Card with Subtle Contrast, Green accent border, green badge, PLAY, Rename, Duplicate, Upgrade, Trash buttons) -->



        <DataTemplate x:Key="templateVersionInstalled" DataType="{x:Type local:Version}">



            <Border Background="#1C1E2A" BorderBrush="#38A169" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,10" Padding="16,14">



                <Grid>



                    <Grid.ColumnDefinitions>



                        <ColumnDefinition Width="Auto" />



                        <ColumnDefinition Width="*" />



                        <ColumnDefinition Width="Auto" />



                    </Grid.ColumnDefinitions>



                    



                    <!-- Green Block Icon -->



                    <Border Grid.Column="0" Width="40" Height="40" Background="#14151F" BorderBrush="#38A169" BorderThickness="1.5" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Center">



                        <Image Source="Assets/bugrock_block.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>



                    </Border>



                    



                    <StackPanel Grid.Column="1" VerticalAlignment="Center">



                        <StackPanel Orientation="Horizontal">



                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>



                            <Border Background="#1C2E22" BorderBrush="#38A169" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">



                                <TextBlock Text="{Binding DisplayVersionType}" Foreground="#38A169" FontSize="10" FontWeight="Bold"/>



                            </Border>



                        </StackPanel>



                        <TextBlock Text="{Binding DisplayInstallStatus}" Foreground="#A0A5BD" FontSize="11" Margin="0,4,0,0"/>



                    </StackPanel>







                    <!-- Action Buttons Panel -->



                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">



                        <!-- Upgrade button (shown when CanUpgrade is true) -->



                        <Button x:Name="UpgradeButton" Content="&#x2B06; UPGRADE" Command="{Binding UpgradeCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" Height="38" Padding="14,6" FontSize="12" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand" ToolTip="Upgrade this instance to newer version in-place">



                            <Button.Style>



                                <Style TargetType="Button">



                                    <Setter Property="Background" Value="#2D1936"/>



                                    <Setter Property="Foreground" Value="#E879F9"/>



                                    <Setter Property="BorderBrush" Value="#D05CE3"/>



                                    <Setter Property="BorderThickness" Value="1"/>



                                    <Setter Property="Visibility" Value="Collapsed"/>



                                    <Setter Property="Template">



                                        <Setter.Value>



                                            <ControlTemplate TargetType="Button">



                                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">



                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>



                                                </Border>



                                                <ControlTemplate.Triggers>



                                                    <Trigger Property="IsMouseOver" Value="True">



                                                        <Setter TargetName="btnBorder" Property="Background" Value="#3D1D4A"/>



                                                        <Setter Property="Foreground" Value="#FFFFFF"/>



                                                    </Trigger>



                                                </ControlTemplate.Triggers>



                                            </ControlTemplate>



                                        </Setter.Value>



                                    </Setter>



                                    <Style.Triggers>



                                        <DataTrigger Binding="{Binding CanUpgrade}" Value="True">



                                            <Setter Property="Visibility" Value="Visible"/>



                                        </DataTrigger>



                                    </Style.Triggers>



                                </Style>



                            </Button.Style>



                        </Button>







                        <!-- PLAY Button -->



                        <Button x:Name="DownloadButton" Style="{StaticResource GiantPlayButtonStyle}" Content="PLAY" Command="{Binding LaunchCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" MinWidth="85" Height="38" Padding="18,6" FontSize="14" FontWeight="Bold" Margin="0,0,8,0"/>







                        <!-- Rename Button -->



                        <Button x:Name="RenameButton" Content="&#x270F;" Command="{Binding RenameCommand}" CommandParameter="{Binding}" Style="{StaticResource DarkButtonStyle}" VerticalAlignment="Center" Width="38" Height="38" Padding="0" FontSize="14" ToolTip="Rename instance" Margin="0,0,8,0"/>







                        <!-- Duplicate / Clone Button -->



                        <Button x:Name="DuplicateButton" Content="&#x1F4CB;" Command="{Binding DuplicateCommand}" CommandParameter="{Binding}" Style="{StaticResource DarkButtonStyle}" VerticalAlignment="Center" Width="38" Height="38" Padding="0" FontSize="14" ToolTip="Duplicate / Clone this instance" Margin="0,0,8,0"/>







                        <!-- Remove Button -->



                        <Button x:Name="RemoveButton" Style="{StaticResource DangerButtonStyle}" Content="&#x1F5D1;" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" Width="38" Height="38" Padding="0" FontSize="14" ToolTip="Uninstall this version / instance"/>



                    </StackPanel>



                </Grid>



            </Border>



        </DataTemplate>







        <!-- Template for Version Downloading (Mockup Style: Dynamic Accent border, progress bar, cancel button, download speed indicator) -->



        <DataTemplate x:Key="templateVersionDownloading" DataType="{x:Type local:Version}">



            <Border Background="#1C1E2A" BorderBrush="{Binding StateChangeInfo.StateAccentBrush}" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,10" Padding="16,14">



                <Grid>



                    <Grid.ColumnDefinitions>



                        <ColumnDefinition Width="Auto" />



                        <ColumnDefinition Width="*" />



                        <ColumnDefinition Width="Auto" />



                    </Grid.ColumnDefinitions>



                    <Grid.RowDefinitions>



                        <RowDefinition Height="Auto"/>



                        <RowDefinition Height="Auto"/>



                        <RowDefinition Height="Auto"/>



                    </Grid.RowDefinitions>



                    



                    <!-- Version Block Icon with dynamic accent border -->



                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Background="#14151F" BorderBrush="{Binding StateChangeInfo.StateAccentBrush}" BorderThickness="1.5" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Top">



                        <Image Source="Assets/bugrock_block.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>



                    </Border>



                    



                    <!-- Row 0: Version Title & Type Badge -->



                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">



                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>



                        <Border Background="{Binding StateChangeInfo.StateBadgeBackgroundBrush}" BorderBrush="{Binding StateChangeInfo.StateAccentBrush}" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">



                            <TextBlock Text="{Binding DisplayVersionType}" Foreground="{Binding StateChangeInfo.StateAccentBrush}" FontSize="10" FontWeight="Bold"/>



                        </Border>



                    </StackPanel>







                    <Button Grid.Row="0" Grid.Column="2" Content="&#x2715;" Width="28" Height="28" Style="{StaticResource DangerButtonStyle}" Padding="0" VerticalAlignment="Center" Command="{Binding StateChangeInfo.CancelCommand}" IsEnabled="{Binding StateChangeInfo.HasCancelCommand}" ToolTip="Cancel download"/>







                    <!-- Row 1: Status on Left, Download Speed on Right (Directly Above Progress Bar) -->



                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,4">



                        <TextBlock Text="{Binding StateChangeInfo.DisplayStatus}" Foreground="{Binding StateChangeInfo.StateAccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>







                        <!-- Speed Badge (e.g. ⚡ 14.8 MB/s) -->



                        <Border Visibility="{Binding StateChangeInfo.SpeedVisibility}" Background="#2B1530" BorderBrush="#D05CE3" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">



                            <StackPanel Orientation="Horizontal">



                                <TextBlock Text="⚡ " Foreground="#D05CE3" FontSize="10" VerticalAlignment="Center"/>



                                <TextBlock Text="{Binding StateChangeInfo.DownloadSpeedText}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>



                            </StackPanel>



                        </Border>



                    </Grid>







                    <!-- Row 2: Thin Progress Bar (4px) with dynamic Accent (Green for extracting/staging) -->



                    <Canvas Name="progressSizeHack" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="4" Margin="0,4,0,0">



                        <ProgressBar Width="{Binding Path=ActualWidth, ElementName=progressSizeHack, Mode=OneWay}" Height="{Binding Path=ActualHeight, ElementName=progressSizeHack, Mode=OneWay}" Minimum="0" Maximum="{Binding StateChangeInfo.MaxProgress}" Value="{Binding StateChangeInfo.Progress}" IsIndeterminate="{Binding StateChangeInfo.IsProgressIndeterminate}" Foreground="{Binding StateChangeInfo.StateAccentBrush}" Background="#12131A" BorderThickness="0"/>



                    </Canvas>



                </Grid>



            </Border>



        </DataTemplate>







        <!-- Version List Template -->



        <ControlTemplate x:Key="templateVersionList" TargetType="ContentControl">



            <ListBox ItemsSource="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">



                <ListBox.ItemContainerStyle>



                    <Style TargetType="ListBoxItem">



                        <Setter Property="Padding" Value="0"/>



                        <Setter Property="Margin" Value="0"/>



                        <Setter Property="Background" Value="Transparent"/>



                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>



                        <Setter Property="Template">



                            <Setter.Value>



                                <ControlTemplate TargetType="ListBoxItem">



                                    <ContentPresenter />



                                </ControlTemplate>



                            </Setter.Value>



                        </Setter>



                    </Style>



                </ListBox.ItemContainerStyle>



                <ListBox.ItemTemplate>



                    <DataTemplate>



                        <ContentControl x:Name="control" Content="{Binding}" ContentTemplate="{StaticResource templateVersionNotInstalled}"/>



                        <DataTemplate.Triggers>



                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">



                                <Setter TargetName="control" Property="ContentTemplate" Value="{StaticResource templateVersionInstalled}"/>



                            </DataTrigger>



                            <DataTrigger Binding="{Binding IsStateChanging}" Value="True">



                                <Setter TargetName="control" Property="ContentTemplate" Value="{StaticResource templateVersionDownloading}"/>



                            </DataTrigger>



                        </DataTemplate.Triggers>



                    </DataTemplate>



                </ListBox.ItemTemplate>



            </ListBox>



        </ControlTemplate>



            <Style x:Key="TopBarNavButtonStyle" TargetType="Button">



            <Setter Property="Background" Value="Transparent"/>



            <Setter Property="Foreground" Value="#8E92A4"/>



            <Setter Property="BorderThickness" Value="0"/>



            <Setter Property="Padding" Value="10,4"/>



            <Setter Property="FontSize" Value="12"/>



            <Setter Property="FontWeight" Value="SemiBold"/>



            <Setter Property="Cursor" Value="Hand"/>



            <Setter Property="Template">



                <Setter.Value>



                    <ControlTemplate TargetType="Button">



                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">



                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>



                        </Border>



                        <ControlTemplate.Triggers>



                            <Trigger Property="IsMouseOver" Value="True">



                                <Setter TargetName="bdr" Property="Background" Value="#1E202C"/>



                                <Setter Property="Foreground" Value="#FFFFFF"/>



                            </Trigger>



                        </ControlTemplate.Triggers>



                    </ControlTemplate>



                </Setter.Value>



            </Setter>



        </Style>







    



        <!-- Dark Theme ComboBox Style -->



        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="ToggleButton">



            <Border x:Name="Border" Background="#161824" BorderBrush="#2F3652" BorderThickness="1" CornerRadius="6">



                <Grid>



                    <Grid.ColumnDefinitions>



                        <ColumnDefinition Width="*"/>



                        <ColumnDefinition Width="28"/>



                    </Grid.ColumnDefinitions>



                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#8E92A4"/>



                </Grid>



            </Border>



            <ControlTemplate.Triggers>



                <Trigger Property="IsMouseOver" Value="True">



                    <Setter TargetName="Border" Property="BorderBrush" Value="#4A5578"/>



                </Trigger>



                <Trigger Property="IsChecked" Value="True">



                    <Setter TargetName="Border" Property="BorderBrush" Value="#D911AB"/>



                </Trigger>



            </ControlTemplate.Triggers>



        </ControlTemplate>







        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">



            <Setter Property="Foreground" Value="#FFFFFF"/>



            <Setter Property="Background" Value="#161824"/>



            <Setter Property="BorderBrush" Value="#2F3652"/>



            <Setter Property="BorderThickness" Value="1"/>



            <Setter Property="FontSize" Value="12"/>



            <Setter Property="FontFamily" Value="{StaticResource FontEpilogue}"/>



