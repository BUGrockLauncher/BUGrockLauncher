                <Grid Name="LoadingProgressGrid" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center">



                    <Grid.ColumnDefinitions>



                        <ColumnDefinition Width="Auto" />



                        <ColumnDefinition Width="Auto" />



                    </Grid.ColumnDefinitions>



                    <Label Grid.Row="0" Grid.Column="0" Name="LoadingProgressLabel" Content="" Foreground="#AAAAAA" FontSize="11" Padding="0,0,0,0" VerticalAlignment="Center"/>



                    <ProgressBar Grid.Row="0" Grid.Column="1" Name="LoadingProgressBar" Width="100" Height="4" Margin="8,0,0,0" Maximum="5" Value="0" Background="#181921" Foreground="#38A169" BorderThickness="0" VerticalAlignment="Center"/>



                </Grid>







                <!-- Right: Privacy Policy & Terms of Use Links -->



                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">



                    <TextBlock Text="Privacy Policy" Foreground="#606478" FontSize="11" Margin="0,0,10,0" Cursor="Hand"/>



                    <TextBlock Text="|" Foreground="#232530" Margin="0,0,10,0"/>



