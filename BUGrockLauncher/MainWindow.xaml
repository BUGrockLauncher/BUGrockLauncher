                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">



                                        <Border Width="24" Height="24" Background="#241433" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center">



