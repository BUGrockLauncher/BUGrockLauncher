                                        </Border>



                                        <TextBlock Text="LAUNCHER PREFERENCES &amp; DOWNLOADS" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>



                                    </StackPanel>







                                    <Border Height="1" Background="#232636" Margin="0,0,0,14"/>







                                    <Grid Margin="0,0,0,14">



                                        <Grid.ColumnDefinitions>



                                            <ColumnDefinition Width="*"/>



                                            <ColumnDefinition Width="Auto"/>



                                        </Grid.ColumnDefinitions>



                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">



                                            <TextBlock Text="Delete .appx package after extraction" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>



                                            <TextBlock Text="Saves disk space by deleting the raw downloaded archive once the version is installed." Foreground="#767A92" FontSize="11" Margin="0,2,0,0"/>



                                        </StackPanel>



                                        <CheckBox Grid.Column="1" x:Name="SettingsDeleteAppxToggle" Click="SettingsDeleteAppxToggle_Click" Style="{StaticResource ModernPillToggleStyle}" VerticalAlignment="Center" Margin="16,0,0,0"/>



                                    </Grid>







                                    <Grid Margin="0,0,0,14">



                                        <Grid.ColumnDefinitions>



                                            <ColumnDefinition Width="*"/>



                                            <ColumnDefinition Width="Auto"/>



                                        </Grid.ColumnDefinitions>



                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">



                                            <TextBlock Text="Auto-fetch decryption keys for GDK" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>



                                            <TextBlock Text="Automatically queries known keys for protected GDK packages during installation." Foreground="#767A92" FontSize="11" Margin="0,2,0,0"/>



                                        </StackPanel>



                                        <CheckBox Grid.Column="1" x:Name="SettingsAutoKeysToggle" Click="SettingsAutoKeysToggle_Click" Style="{StaticResource ModernPillToggleStyle}" VerticalAlignment="Center" Margin="16,0,0,0"/>



                                    </Grid>







                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">



                                        <Button Content="🌐 Versions API Endpoints..." Click="MenuItemSetVersionListEndpointClicked" Style="{StaticResource DarkButtonStyle}" Height="30" Padding="14,0" FontSize="11"/>



                                    </StackPanel>



                                </StackPanel>



                            </Border>







                            <!-- CARD 5: System Tools & Maintenance -->



                            <Border x:Name="CardSystemTools" Background="#161822" BorderBrush="#292D3E" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">



                                <StackPanel>



                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">



                                        <Border Width="24" Height="24" Background="#2D1318" BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center">



                                            <Path Data="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" Fill="#FB7185" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>



                                        </Border>



                                        <TextBlock Text="SYSTEM TOOLS &amp; MAINTENANCE" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>



                                    </StackPanel>







                                    <Border Height="1" Background="#232636" Margin="0,0,0,14"/>







                                    <WrapPanel>



                                        <Button Content="🔍 Run BUGrock Check (System Utility)" Click="SettingsLaunchCheckerBtn_Click" Style="{StaticResource DarkButtonStyle}" Height="32" Padding="14,0" FontSize="11" Margin="0,0,8,8"/>



                                        <Button Content="📁 Open Local Data Directory" Click="MenuItemOpenDataDirClicked" Style="{StaticResource DarkButtonStyle}" Height="32" Padding="14,0" FontSize="11" Margin="0,0,8,8"/>



                                        <Button Content="📄 Open Log File" Click="MenuItemOpenLogFileClicked" Style="{StaticResource DarkButtonStyle}" Height="32" Padding="14,0" FontSize="11" Margin="0,0,8,8"/>



                                        <Button Content="🧹 Fix MS Store &amp; Clean Packages" Click="MenuItemCleanupForStoreInstallClicked" Style="{StaticResource DangerButtonStyle}" Height="32" Padding="14,0" FontSize="11" Margin="0,0,8,8"/>



                                    </WrapPanel>



                                </StackPanel>



                            </Border>







                        </StackPanel>



                    </ScrollViewer>



                </Grid>







                <!-- In-App Web Browser Overlay (for Community Hub & Downloads) -->



                <Grid x:Name="InAppBrowserOverlay" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="100" Background="#0F1015">



                    <Grid.RowDefinitions>



                        <!-- Browser Toolbar (42px) -->



                        <RowDefinition Height="42"/>



                        <!-- Browser Content -->



                        <RowDefinition Height="*"/>



                        <!-- Download Notification Toast Bar -->



                        <RowDefinition Height="Auto"/>



                    </Grid.RowDefinitions>







                    <!-- Top Browser Navigation Bar -->



                    <Border Grid.Row="0" Background="#13141A" BorderBrush="#232530" BorderThickness="0,0,0,1" Padding="12,0">



                        <Grid VerticalAlignment="Center">



                            <Grid.ColumnDefinitions>



                                <ColumnDefinition Width="Auto"/>



                                <ColumnDefinition Width="*"/>



                                <ColumnDefinition Width="Auto"/>



                            </Grid.ColumnDefinitions>







                            <!-- Navigation controls -->



                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">



                                <Button x:Name="BrowserBackBtn" Content="←" Style="{StaticResource DarkButtonStyle}" Width="28" Height="26" Padding="0" FontSize="13" Click="BrowserBackBtn_Click" ToolTip="Go Back"/>



                                <Button x:Name="BrowserForwardBtn" Content="→" Style="{StaticResource DarkButtonStyle}" Width="28" Height="26" Padding="0" FontSize="13" Margin="4,0,0,0" Click="BrowserForwardBtn_Click" ToolTip="Go Forward"/>



                                <Button x:Name="BrowserRefreshBtn" Content="⟳" Style="{StaticResource DarkButtonStyle}" Width="28" Height="26" Padding="0" FontSize="12" Margin="4,0,0,0" Click="BrowserRefreshBtn_Click" ToolTip="Refresh Page"/>



                                <!-- MCPEDL Button with Official DL Badge -->

                                <Button x:Name="BrowserMCPEDLToggleBtn" Style="{StaticResource DarkButtonStyle}" Height="28" Padding="10,0" Margin="10,0,0,0" Click="BrowserMCPEDLToggleBtn_Click" ToolTip="Switch to MCPEDL">

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <Border Width="16" Height="16" Background="#FF7A00" CornerRadius="3" Margin="0,0,6,0" VerticalAlignment="Center">

                                            <TextBlock Text="DL" Foreground="#FFFFFF" FontWeight="Black" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>

                                        </Border>

                                        <TextBlock Text="MCPEDL" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>



                                <!-- CurseForge Button with Official Flame Emblem -->

                                <Button x:Name="BrowserCurseForgeToggleBtn" Style="{StaticResource DarkButtonStyle}" Height="28" Padding="10,0" Margin="4,0,0,0" Click="BrowserCurseForgeToggleBtn_Click" ToolTip="Switch to CurseForge Bedrock">

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <Path Data="M12 2c-.6 2.8-2.8 4.6-5 6.8-2.2 2.2-3.8 5-3.8 8.4A8.8 8.8 0 0 0 12 26a8.8 8.8 0 0 0 8.8-8.8c0-4-2.8-7.4-4.5-9.6-1.1-1.7-1.7-3.4-1.7-5.6 0 0-1.7 1.1-2.8 2.2-.6-1.3-.8-2.8-.8-4.2z" Fill="#F16436" Width="13" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                        <TextBlock Text="CurseForge" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>



                            </StackPanel>







                            <!-- URL Bar & Status -->



                            <Border Grid.Column="1" Background="#181921" BorderBrush="#282A36" BorderThickness="1" CornerRadius="5" Height="28" Margin="12,0" Padding="10,0">



                                <Grid VerticalAlignment="Center">



                                    <TextBlock x:Name="BrowserUrlText" Text="https://mcpedl.com" Foreground="#8E92A4" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>



                                </Grid>



                            </Border>







                            <!-- Right controls: Open DDFW Folder & Close -->



                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">



                                <Button x:Name="OpenDDFWFolderBtn" Content="📁 DDFW Folder" Style="{StaticResource DarkButtonStyle}" Height="26" Padding="10,0" FontSize="11" Click="OpenDDFWFolderBtn_Click" ToolTip="Open DDFW Downloads Folder"/>



                                <!-- Glowing Vivid Red Close Button -->

                                <Button x:Name="CloseBrowserBtn" Height="28" Padding="14,0" Margin="8,0,0,0" Click="CloseBrowserBtn_Click" Cursor="Hand" FocusVisualStyle="{x:Null}">

                                    <Button.Style>

                                        <Style TargetType="Button">

                                            <Setter Property="Background" Value="#DC2626"/>

                                            <Setter Property="BorderBrush" Value="#EF4444"/>

                                            <Setter Property="BorderThickness" Value="1"/>

                                            <Setter Property="Foreground" Value="#FFFFFF"/>

                                            <Setter Property="FontFamily" Value="{StaticResource FontEpilogue}"/>

                                            <Setter Property="FontWeight" Value="Bold"/>

                                            <Setter Property="FontSize" Value="11.5"/>

                                            <Setter Property="Template">

                                                <Setter.Value>

                                                    <ControlTemplate TargetType="Button">

                                                        <Border x:Name="CloseBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">

                                                            <Border.Effect>

                                                                <DropShadowEffect x:Name="CloseGlow" Color="#EF4444" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>

                                                            </Border.Effect>

                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        </Border>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CloseBorder" Property="Background" Value="#EF4444"/>
                                                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="#FCA5A5"/>
                                                                <Setter TargetName="CloseBorder" Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#EF4444" BlurRadius="18" ShadowDepth="0" Opacity="0.95"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="CloseBorder" Property="Background" Value="#B91C1C"/>
                                                                <Setter TargetName="CloseBorder" Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#EF4444" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Setter.Value>

                                            </Setter>

                                        </Style>

                                    </Button.Style>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center"/>

                                        <TextBlock Text="Close" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>



                            </StackPanel>



                        </Grid>



                    </Border>







                    <!-- Browser Main WebView2 -->



                    <Border Grid.Row="1" Background="#161C23">



                        <wv2:WebView2 x:Name="BrowserWebView"/>



                    </Border>







                    <!-- In-App Browser Download Progress & Status Bar -->



                    <Border Grid.Row="2" x:Name="DownloadToastBar" Visibility="Collapsed" Background="#111319" BorderBrush="#252836" BorderThickness="0,1,0,0" Padding="16,10">



                        <Grid>



                            <Grid.RowDefinitions>



                                <RowDefinition Height="Auto"/>



                                <RowDefinition Height="Auto"/>



                            </Grid.RowDefinitions>



                            <Grid.ColumnDefinitions>



                                <ColumnDefinition Width="*"/>



                                <ColumnDefinition Width="Auto"/>



                            </Grid.ColumnDefinitions>







                            <!-- Status, Name, and Progress Details -->



                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,7">



