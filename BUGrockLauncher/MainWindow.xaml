        <!-- ============================================================== -->



        <Border x:Name="GlobalModalDimOverlay" Grid.Row="0" Grid.RowSpan="3"



                Background="#B306070B" Panel.ZIndex="9999"



                Visibility="Collapsed" IsHitTestVisible="True" Focusable="False"/>



    </Grid>



</Window>



