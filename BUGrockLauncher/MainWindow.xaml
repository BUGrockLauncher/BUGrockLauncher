                                <TextBlock x:Name="DownloadToastText" Text="Downloading mod..." Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="450"/>



                                <TextBlock x:Name="DownloadToastDetails" Text="" Foreground="#8E92A4" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"/>



                            </StackPanel>







