                                <Button x:Name="DownloadShowInFolderBtn" Content="Show in Folder" Style="{StaticResource DarkButtonStyle}" Height="24" Padding="10,0" FontSize="11" Margin="6,0,0,0" Click="ToastShowInFolder_Click" Visibility="Collapsed"/>



                                <Button Content="✕" Style="{StaticResource DarkButtonStyle}" Width="24" Height="24" Padding="0" Margin="6,0,0,0" FontSize="11" Click="ToastDismiss_Click"/>



                            </StackPanel>







                            <!-- Live Progress Bar -->



                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DownloadProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" Background="#1E202C" Foreground="#38A169" BorderThickness="0"/>



                        </Grid>



                    </Border>



                </Grid>



            </Grid>



        </Grid>







        <!-- ============================================================== -->



        <!-- 3. BOTTOM STATUS BAR (30px)                                    -->



        <!-- ============================================================== -->



        <Border Grid.Row="2" Background="#0B0C0F" BorderBrush="#1C1D24" BorderThickness="0,1,0,0" Padding="16,0">



            <Grid>



                <Grid.ColumnDefinitions>



                    <ColumnDefinition Width="Auto"/>



                    <ColumnDefinition Width="*"/>



                    <ColumnDefinition Width="Auto"/>



                </Grid.ColumnDefinitions>







                <!-- Left: Services Status & Client Version -->



