                                </StackPanel>



                            </Border>







                            <!-- CARD 4: General Launcher & Download Options -->



                            <Border x:Name="CardPreferences" Background="#161822" BorderBrush="#292D3E" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">



